{
  "_comment": "Copie este arquivo para config.local.json e ajuste para seu ambiente",
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "protocol": "http"
  },
  "sync": {
    "auto_sync": false,
    "check_interval_minutes": 30,
    "verify_hash": true,
    "delete_removed": false,
    "max_concurrent_downloads": 2
  },
  "paths": {
    "roms": {
      "remote": "/roms",
      "local": "./test_sd/roms/"
    },
    "covers": {
      "remote": "/covers",
      "local": "./test_sd/roms/covers/"
    },
    "saves": {
      "remote": "/saves",
      "local": "./test_sd/roms/saves/"
    }
  },
  "filters": {
    "extensions": [".nsp", ".xci", ".nro"],
    "max_file_size_mb": 0,
    "exclude_patterns": ["._*", ".DS_Store", "Thumbs.db"]
  }
}
